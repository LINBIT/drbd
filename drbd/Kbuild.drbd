#!make # syntax highlighting

# PRE_CFLAGS may contain (M)OFED header locations
LINUXINCLUDE := $(PRE_CFLAGS) -I$(src) -I$(src)/drbd-headers -I$(src)/drbd-headers/uapi $(LINUXINCLUDE)

# Files in the standard include directories take precendence over files
# in the drbd-kernel-compat directory.
#
# Add -I$(src) to EXTRA_CFLAGS again: some (rhel5, maybe other) kbuild does not
# yet use LINUXINCLUDE like we expect it to ;( fortunately it does not contain
# in-tree drbd either yet, so precedence of include files is not important.
#
# override: we absolutely need this, even if EXTRA_CFLAGS originates from make
# command line or environment
override EXTRA_CFLAGS += -I$(src) -I$(src)/drbd-kernel-compat

ifneq ($(strip $(shell \
	grep -q -e '\<nsecs_to_jiffies\>' $(objtree)/Module.symvers || \
	grep -q -e 'EXPORT_SYMBOL(nsecs_to_jiffies)' $(srctree)/kernel/time/time.c ; \
	echo $$?)),0)
compat_objs += drbd-kernel-compat/nsecs_to_jiffies.o
endif

ifndef CONFIG_LRU_CACHE
compat_objs += drbd-kernel-compat/lru_cache.o
endif

compat_objs += drbd-kernel-compat/drbd_wrappers.o

# The drbd2 netlink family is built from the stock YNL output, which needs
# the split generic netlink ops, the big-endian netlink policy types and the
# formatted extack messages, all of v6.2. Distribution kernels backport these
# independently of each other, so every one of them is tested for. Older
# kernels keep the legacy "drbd" family only; none of the coccinelle compat
# rules are written for drbd2.
CONFIG_DRBD_NL_DRBD2 := $(shell \
	grep -qe '^.define COMPAT_HAVE_GENL_PRE_DOIT_SPLIT_OPS$$' $(src)/compat.h \
	&& grep -qe '^.define COMPAT_HAVE_NLA_BE16$$' $(src)/compat.h \
	&& grep -qe '^.define COMPAT_HAVE_NL_SET_ERR_MSG_FMT$$' $(src)/compat.h \
	&& echo y)

# The vendored v1 ("drbd" family, DRBD 8.4 compat) netlink policy tables
# use NLA_POLICY_MAX_LEN, added in Linux v6.13. That file is exempted
# from the coccinelle compat pipeline entirely (its split-ops table must
# not be rewritten by genl_pre_doit_split_ops__no_present.cocci), so
# unlike drbd_nl_gen.c's own v2 tables it never gets the fallback rewrite
# for older kernels; the kernel genuinely needs the symbol.
CONFIG_DRBD_84_HAVE_NLA_POLICY_MAX_LEN := $(shell \
	grep -qe '^.define COMPAT_HAVE_NLA_POLICY_MAX_LEN$$' $(src)/compat.h \
	&& echo y)

ifdef CONFIG_TLS
ifndef CONFIG_NET_HANDSHAKE
# TLS is enabled in the kernel,
# but they did not enable NET_HANDSHAKE.
# If our compat test case thinks the kernel is recent enough to support it,
# we need to provide it.
# Different versions of Make treat the '#' sign (in '#define') differently,
# some want it escaped, others need it unescaped. Could use $(pound).
# But just wildcard it.
COMPAT_NET_HANDSHAKE := $(shell set -x; grep -qe '^.define COMPAT_HAVE_TLS_TX_RX$$' $(src)/compat.h && echo m)
endif
endif

# ================================================================
CONFIG_BLK_DEV_DRBD := m
obj-$(CONFIG_BLK_DEV_DRBD)       += drbd.o
obj-$(CONFIG_BLK_DEV_DRBD)       += drbd_transport_tcp.o
obj-$(CONFIG_BLK_DEV_DRBD)       += drbd_transport_lb-tcp.o
obj-$(if $(CONFIG_INFINIBAND_ADDR_TRANS),m) += drbd_transport_rdma.o
obj-$(if $(CONFIG_INFINIBAND_ADDR_TRANS),m) += drbd_transport_rdma2.o
obj-$(COMPAT_NET_HANDSHAKE)      += drbd-kernel-compat/handshake/
# ================================================================

ifdef CONFIG_DEV_DAX_PMEM
CONFIG_DRBD_DAX := y
endif

# enable fault injection by default
ifndef CONFIG_DRBD_FAULT_INJECTION
	override EXTRA_CFLAGS += -DCONFIG_DRBD_FAULT_INJECTION
	ccflags-y += -DCONFIG_DRBD_FAULT_INJECTION
endif

# DRBD 8.4 compatibility: 8.4 on-disk metadata and the 8.4 /proc/drbd
# rendering. This is the flag's original, already-shipped meaning and it
# carries no kernel floor: it builds on everything from 4.18 up, exactly
# as it always has. It does NOT by itself change which generic netlink
# family serves drbdsetup; that is CONFIG_DRBD_NL_DRBD1, below.
# Disabled for the external module build by default.
# In upstream Linux, this should default to yes.
# Enable by adding "CONFIG_DRBD_COMPAT_84=y" to your make command line.
CONFIG_DRBD_COMPAT_84 := n

# The version 1 ("drbd" family) netlink dialect, serving genuine DRBD 8.4
# userland (drbdsetup-84/drbdadm-84) in place of DRBD 9's own v2 dialect.
# The two dialects are mutually exclusive: only one genl family may be
# named "drbd".
# The vendored v1 netlink code needs a kernel v6.13 or later (see the
# CONFIG_DRBD_84_HAVE_NLA_POLICY_MAX_LEN comment above); the split generic
# netlink ops it also needs arrived earlier (v6.2) and are implied by that
# floor.
# The v1 dialect is meaningless without 8.4 on-disk metadata and /proc
# rendering, so enabling it implies CONFIG_DRBD_COMPAT_84=y; you do not
# need to (and should not need to remember to) set both.
# Defaults to OFF even on kernels above the floor, deliberately: lbbuild
# builds these as production packages (it passes CONFIG_DRBD_COMPAT_84=y
# for every distro unconditionally), and silently switching a package
# from the v2 dialect to v1 would break LINSTOR, drbdmon and every modern
# tool built against it. Selecting the v1 wire dialect is a separate,
# explicit opt-in.
# Disabled for the external module build by default.
# Enable by adding "CONFIG_DRBD_NL_DRBD1=y" to your make command line.
CONFIG_DRBD_NL_DRBD1 := n

ifeq ($(CONFIG_DRBD_NL_DRBD1),y)
override CONFIG_DRBD_COMPAT_84 := y
# The vendored v1 files carry mainline's includes verbatim: a quoted
# "drbd_nl_gen.h" next to the .c, and <uapi/linux/drbd_genl.h>, which
# must resolve to the v1 header in drbd-84/uapi, not to DRBD 9's own v2
# header under drbd-headers/uapi. LINUXINCLUDE is searched first, so
# put drbd-84 in front of it. The only other users of that header are
# the three DRBD_FAMILY_VERSION printers, which then correctly report
# the family version a v1 build actually serves.
LINUXINCLUDE := -I$(src)/drbd-84 $(LINUXINCLUDE)
ifneq ($(CONFIG_DRBD_NL_DRBD2),y)
$(error CONFIG_DRBD_NL_DRBD1=y needs a kernel v6.13 or later; this one \
  lacks the split generic netlink ops (COMPAT_HAVE_GENL_PRE_DOIT_SPLIT_OPS, \
  v6.2), so CONFIG_DRBD_NL_DRBD2 is not y)
endif
ifneq ($(CONFIG_DRBD_84_HAVE_NLA_POLICY_MAX_LEN),y)
$(error CONFIG_DRBD_NL_DRBD1=y needs a kernel v6.13 or later; this one \
  lacks NLA_POLICY_MAX_LEN (COMPAT_HAVE_NLA_POLICY_MAX_LEN, v6.13), which \
  the vendored v1 netlink policy tables use)
endif
endif

# For drbd_strings.c. Could also use drbd-y += drbd-headers/drbd_strings.o,
# but I don't think we should produce .o files in that directory.
# Older kernel trees may not have cmd_copy yet.
ifndef cmd_copy
quiet_cmd_copy = COPY    $@
      cmd_copy = cat $< > $@
endif

$(obj)/drbd_strings.c: $(src)/drbd-headers/drbd_strings.c
	$(call cmd,copy)

drbd-y += drbd_buildtag.o
drbd-y += drbd_bitmap.o
drbd-y += drbd_proc.o
drbd-y += drbd_sender.o
drbd-y += drbd_receiver.o
drbd-y += drbd_req.o
drbd-y += drbd_actlog.o
drbd-y += drbd_main.o
drbd-y += drbd_strings.o
drbd-y += drbd_nl.o
ifeq ($(CONFIG_DRBD_NL_DRBD1),y)
drbd-y += drbd_nl_84.o drbd-84/drbd_nl_gen.o
else
drbd-y += drbd_nl_legacy.o drbd-headers/linux/drbd_nl_gen.o
endif
drbd-y += drbd-headers/linux/drbd_nl_defaults.o
drbd-y += drbd_interval.o
drbd-y += drbd_state.o
drbd-y += drbd_transport.o
drbd-y += $(compat_objs)

drbd-$(CONFIG_DRBD_DAX)   += drbd_dax_pmem.o
drbd-$(CONFIG_KREF_DEBUG) += kref_debug.o drbd_kref_debug.o
drbd-$(CONFIG_DEBUG_FS)   += drbd_debugfs.o
drbd-$(CONFIG_DRBD_COMPAT_84) += drbd_legacy_84.o
drbd-$(CONFIG_DRBD_NL_DRBD2) += drbd_nl_drbd2.o drbd-headers/linux/drbd2_nl_gen.o

ccflags-$(CONFIG_DRBD_COMPAT_84) += -DCONFIG_DRBD_COMPAT_84
ccflags-$(CONFIG_DRBD_NL_DRBD2) += -DCONFIG_DRBD_NL_DRBD2
# CONFIG_DRBD_NL_DRBD1 only picks the objects above. In-tree the "drbd"
# family is always version 1 and exists exactly with CONFIG_DRBD_COMPAT_84,
# so the sources go by that; tell them when this build serves DRBD 9's own
# version 2 of the family instead.
ifneq ($(CONFIG_DRBD_NL_DRBD1),y)
ccflags-y += -DDRBD_NL_FAMILY_V2
endif
